<%- include("partials/header", { titulo: "Inscripción" }) %>
<a class="volver" href="/talleres/<%= taller.id %>">← Volver al taller</a>
<section class="panel formulario">
  <p class="eyebrow">FORMULARIO DE INSCRIPCIÓN</p>
  <h1><%= taller.titulo %></h1>
  <p><strong><%= taller.estadoPlazas %></strong></p>
  <% if (errores.general) { %><div class="alerta alerta--error"><%= errores.general %></div><% } %>
  <% if (taller.plazasRestantes > 0) { %>
    <form action="/talleres/<%= taller.id %>/inscripcion" method="POST" novalidate>
      <label>Nombre completo
        <input type="text" name="nombre" value="<%= valores.nombre %>" maxlength="80" required>
        <% if (errores.nombre) { %><small class="error"><%= errores.nombre %></small><% } %>
      </label>
      <label>Correo electrónico
        <input type="email" name="email" value="<%= valores.email %>" maxlength="254" required>
        <% if (errores.email) { %><small class="error"><%= errores.email %></small><% } %>
      </label>
      <button class="boton" type="submit">Confirmar inscripción</button>
    </form>
  <% } else { %>
    <a class="boton boton--secundario" href="/talleres">Volver al catálogo</a>
  <% } %>
</section>
<%- include("partials/footer") %>
